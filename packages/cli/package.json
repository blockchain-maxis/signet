{
  "name": "@signet/cli",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Signet terminal tooling — link a machine to your Signet account from the CLI.",
  "type": "module",
  "bin": {
    "signet": "./bin/signet.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config ../../eslint.config.js",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "link": "node bin/signet.ts link"
  },
  "dependencies": {
    "@signet/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}