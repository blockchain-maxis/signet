generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String   @id @default(cuid())
  handle      String   @unique
  displayName String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallets     Wallet[]

  @@index([handle])
}

model Wallet {
  id         String   @id @default(cuid())
  profileId  String
  pubkey     String   @unique
  attestedAt DateTime @default(now())
  source     String   @default("curated")
  isPrimary  Boolean  @default(false)

  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  contracts  Contract[]
  operations Operation[]

  @@index([profileId])
  @@index([pubkey])
}

// Soroban operations (invocations) attributed to a wallet, populated by the
// indexer from Horizon. Powers the activity list on a profile.
model Operation {
  id              String   @id // Horizon operation id (globally unique)
  walletId        String
  type            String
  function        String?
  decodedFunction String?
  sourceAccount   String?
  createdAt       DateTime
  transactionHash String?
  successful      Boolean  @default(true)
  balanceChanges  Json?
  indexedAt       DateTime @default(now())

  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model Contract {
  id              String   @id @default(cuid())
  address         String   @unique
  walletId        String
  deployerPubkey  String
  deployedAt      DateTime
  deployTxHash    String
  network         String   @default("mainnet")
  contractType    String?
  firstIndexedAt  DateTime @default(now())

  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  snapshots       ContractSnapshot[]

  @@index([deployerPubkey])
  @@index([deployedAt])
}

model ContractSnapshot {
  id           String   @id @default(cuid())
  contractId   String
  capturedAt   DateTime @default(now())
  txCount24h   Int      @default(0)
  txCountTotal Int      @default(0)
  lastActivity DateTime?

  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, capturedAt])
}

model IndexerCursor {
  id         String   @id @default("main")
  lastLedger Int      @default(0)
  updatedAt  DateTime @updatedAt
}

/// A `signet link` pairing session — the fallback path used when the CLI
/// cannot receive a loopback callback (remote SSH sessions, dev containers
/// with unmapped ports, locked-down corporate browsers). See
/// apps/web/lib/server/cli-pairing.ts for the full protocol: the CLI mints a
/// session and proves control of `publicKey` via a signed nonce, a signed-in
/// browser tab approves the link, and the CLI collects the result either by
/// polling `pollToken` or by a human typing `completionCode` back into the
/// terminal. `status` moves pending -> approved -> consumed; consumption is
/// single-use by construction (see `consumeApproved`'s conditional update).
model CliPairing {
  id             String   @id @default(cuid())
  /// Short human-facing code; identifies the session in the browser approval URL.
  pairingCode    String   @unique
  /// Long opaque secret returned only to the CLI, used to poll for completion.
  pollToken      String   @unique
  /// Random value the CLI must sign with `publicKey` to prove key ownership.
  nonce          String
  /// Set once approved; a human types this into the CLI as the manual fallback to polling.
  completionCode String?  @unique
  publicKey      String
  network        String
  /// Set once `nonce` has been signed correctly — required before approval.
  proven         Boolean  @default(false)
  /// pending | approved | consumed
  status         String   @default("pending")
  /// The profile the wallet was linked to, set on approval.
  profileId      String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
