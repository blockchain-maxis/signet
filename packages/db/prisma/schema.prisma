generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String   @id @default(cuid())
  handle      String   @unique
  displayName String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallets       Wallet[]
  pairingStates PairingState[]
}

model Wallet {
  id         String   @id @default(cuid())
  profileId  String
  pubkey     String   @unique
  attestedAt DateTime @default(now())
  // Allowed values: 'curated' | 'onchain' | 'cli' — kept as the WalletSource
  // union in packages/types/src/wallet-source.ts (mirrored to Go for the CLI
  // in packages/types/generated/wallet_source.go). Prisma has no native check
  // constraint here, so every write and read site validates against that
  // union instead of trusting this column's raw string.
  source     String   @default("curated")
  isPrimary  Boolean  @default(false)

  // Per-wallet deployment-worker backfill state. The IndexerCursor row below
  // ("main") only tracks forward-scanning progress for the indexer as a
  // whole; it says nothing about how far back into *this* wallet's own
  // Horizon history the deployment worker has walked. Without this, a wallet
  // linked after others either gets re-scanned from the top every tick
  // (wasteful, rate-limited) or has its older history silently skipped once
  // some other global position has moved past it — neither is correct.
  //
  // deploymentCursor is the Horizon paging_token of the oldest operation the
  // deployment worker has walked back to so far; null means backfill hasn't
  // started (or the wallet is new). deploymentBackfilledAt is set once the
  // worker has walked all the way back — Horizon returned an empty page —
  // after which the worker only needs to check the newest activity each tick,
  // not resume a backward walk.
  deploymentCursor       String?
  deploymentBackfilledAt DateTime?

  // Forward progress *after* backfill completes. deploymentCursor walks
  // backwards into history and stops; this walks forwards and never does.
  //
  // Without it the post-backfill check reads a fixed newest-first window
  // anchored to now, so a wallet that accumulates more operations between two
  // ticks than that window holds loses whatever fell out of it — permanently,
  // since the backward walk is already finished and will not revisit. This is
  // the Horizon paging_token of the newest operation the worker has actually
  // examined, so the next tick resumes from there instead of from "now".
  deploymentWatermark    String?

  // Set when a wallet is (re-)linked (apps/web/lib/server/account.ts's
  // linkDeployWallet) so the indexer picks it up promptly instead of waiting
  // out the rest of the current tick interval — see index.ts's idle-sleep
  // loop, which polls for this and starts the next tick early when it's set.
  // Cleared once the deployment worker has scanned the wallet. A plain
  // timestamp column rather than a queue table: relinking just overwrites it,
  // so repeated links can never accumulate duplicate trigger state.
  indexRequestedAt DateTime?

  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  contracts  Contract[]
  operations Operation[]

  @@index([profileId])
}

// Soroban operations (invocations) attributed to a wallet, populated by the
// indexer from Horizon. Powers the activity list on a profile.
model Operation {
  id              String   @id // Horizon operation id (globally unique)
  walletId        String
  type            String
  function        String?
  decodedFunction String?
  sourceAccount   String?
  createdAt       DateTime
  transactionHash String?
  successful      Boolean  @default(true)
  balanceChanges  Json?
  indexedAt       DateTime @default(now())

  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model Contract {
  id                String    @id @default(cuid())
  address           String    @unique
  walletId          String
  deployerPubkey    String
  deployedAt        DateTime
  deployTxHash      String
  // Allowed values: 'testnet' | 'mainnet' | 'futurenet' | 'local' — see NETWORKS
  // in @signet/types and migration 20260926010000_normalise_contract_network
  // which enforces CHECK (network IN ('testnet','mainnet','futurenet','local')).
  // Every writer (today, apps/indexer/src/workers/deployment.ts) must pass
  // the indexer's configured canonical network.
  network           String
  /// @deprecated Superseded by executableType.
  contractType      String?
  /// Lowercase 64-character SHA-256 hex hash of the contract executable WASM.
  /// Joins to `ContractSpec.wasmHash` by plain string equality (both sides are
  /// lowercase hex) — deliberately no FK: a spec row exists independently of
  /// any contract row (see the ContractSpec model), so the relation is a
  /// convention both writers must honour, not a database constraint.
  wasmHash          String?
  /// Executable type: 'wasm' | 'stellar_asset'.
  executableType    String?
  /// Timestamp when the indexer last checked the on-chain executable WASM hash.
  wasmHashCheckedAt DateTime?
  firstIndexedAt    DateTime  @default(now())

  wallet       Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  snapshots    ContractSnapshot[]
  wasmVersions ContractWasmVersion[]
  invocations  ContractInvocation[]

  @@index([deployerPubkey])
  @@index([deployedAt])
  @@index([wasmHash])
}

/// Decoded `contractspecv0` spec keyed by WASM hash (§4.2 of
/// docs/CONTRACT_DOCS_DESIGN.md): many contracts to one spec — two contracts
/// deploying identical WASM share one row, and a rollback to a previous hash
/// hits the row that is already there.
///
/// No FK to Contract: a hash exists independently of any row — the spec can be
/// extracted before (or without) an indexed contract, and `Contract.wasmHash`
/// joins to `wasmHash` by plain string equality instead (see the comment on
/// that column).
///
/// `sdkVersion` is what makes an SDK upgrade re-extractable: a spec decoded by
/// an older SDK — possibly skipping an entry arm that SDK did not know yet —
/// is found by this column, reported stale, re-extracted and overwritten
/// rather than served (see `isStale` in apps/web/lib/server/spec-store.ts).
model ContractSpec {
  /// Lowercase 64-character SHA-256 hex of the contract executable WASM.
  wasmHash      String   @id
  /// Version of the `specJson` serialisation shape (`SpecJson.schemaVersion`,
  /// #434). Below the running schemaVersion means the stored JSON must be
  /// re-serialised from the XDR, not served.
  schemaVersion Int
  /// `@stellar/stellar-sdk` version that decoded the entries, e.g. "16.1.0".
  /// Older than the running SDK means the row is re-extracted (§4.2).
  sdkVersion    String
  /// The serialised spec (`SpecJson`, #434): entries, flattened views and
  /// provenance, in one deterministic JSON document.
  specJson      Json
  extractedAt   DateTime @default(now())
}

/// Version history of executable WASM hashes observed for a contract instance.
model ContractWasmVersion {
  id             String   @id @default(cuid())
  contractId     String
  wasmHash       String
  observedAt     DateTime @default(now())
  /// The RPC's latest ledger when the indexer noticed the hash (not the ledger of the upgrade transaction).
  observedLedger Int

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, wasmHash])
  @@index([contractId, observedAt])
}

/// Per-contract invocation index capturing raw transaction footprints, storage mutations,
/// and metadata for contracts. Populated by the invocations worker via RPC getTransaction.
model ContractInvocation {
  /// Composite ID format: `${txHash}:${opIndex}`
  id                String   @id
  contractId        String
  txHash            String
  ledger            Int
  createdAt         DateTime
  sourceAccount     String
  /// Invoked function name if target is this contract; null if reached only as a sub-call
  function          String?
  successful        Boolean
  /// Contract executable WASM hash at capture time
  wasmHash          String?
  /// Declared read-only footprint as base64 LedgerKeys
  readOnly          Json
  /// Declared read-write footprint as base64 LedgerKeys
  readWrite         Json
  /// Ledger keys actually modified according to transaction result meta (null if meta unavailable)
  changed           Json?
  /// Extracted call edges (filled by #516)
  callEdges         Json?
  /// Contract IDs that emitted events in this invocation
  eventsContractIds String[]
  indexedAt         DateTime @default(now())

  contract          Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, createdAt])
  @@index([contractId, function])
  @@index([contractId, sourceAccount])
}

model ContractSnapshot {
  id           String   @id @default(cuid())
  contractId   String
  capturedAt   DateTime @default(now())
  txCount24h   Int      @default(0)
  txCountTotal Int      @default(0)
  lastActivity DateTime?
  /// Oldest captured `ContractInvocation` the counts cover (#429). Null only on
  /// pre-#429 rows, which came from a Horizon call that always failed and are
  /// all zeros: readers treat null as "not measured".
  countedSince DateTime?
  /// True when the contract's invocation rows are at the capture cap, so
  /// `txCountTotal` is a lower bound.
  totalIsFloor Boolean  @default(false)

  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, capturedAt])
}

model IndexerCursor {
  id         String   @id @default("main")
  lastLedger Int      @default(0)
  updatedAt  DateTime @updatedAt
}

// CLI device-pairing state (`POST /api/cli/pair/{start,approve,complete}`).
//
// Binds a CLI-held deploy account to a browser-authenticated profile without
// either side ever seeing the other's credentials: `start` mints this row,
// `approve` (browser, session-authenticated) records *which* profile is
// pairing, `complete` (CLI, SEP-10-authenticated) proves *which* wallet and
// writes it. `status` only ever moves forward: pending -> approved ->
// completed, or pending -> rejected when the developer refuses in the browser;
// `complete` conditions its update on `status = 'approved'` so two concurrent
// completions of the same pairing cannot both succeed.
model PairingState {
  id          String    @id @default(cuid())
  /// pending | approved | rejected | completed
  status      String    @default("pending")
  /// The canonical network NAME (`testnet` / `mainnet`, #616) the CLI
  /// declared at `start` — validated against the deployment's configured
  /// network before the row is created, and rechecked at `complete`. Rows
  /// predating the name-based wire held a passphrase; they expire within
  /// 5 minutes, so no data migration accompanies the comment.
  network     String
  /// The deploy account the CLI *declared* at `start`, so the browser
  /// approval page can show which key is about to be attached. Unverified
  /// here — it is only a claim until `complete` presents a challenge signed by
  /// it, which is checked against this value. Null for a pairing minted before
  /// this column existed, which completes without that check.
  publicKey   String?
  /// SHA-256 of the poll token `start` hands the CLI, for the polling
  /// fallback (#273). Kept distinct from `id`: the pairing code travels in the
  /// URL the developer opens — and may be pasted into a chat or a ticket —
  /// whereas this never leaves the terminal, so watching a pairing's progress
  /// needs something seeing the link does not give you. Hashed because it is a
  /// bearer credential at rest.
  pollTokenHash String? @unique
  /// SHA-256 of the short code the browser shows after approving, which the
  /// developer pastes back into the terminal when loopback is unreachable.
  /// Binds "the person who approved" to "the terminal that completes" the way
  /// the loopback `state` does on the local path.
  handoffHash String?
  /// SHA-256 of the short user code minted at `start` (#596). The CLI prints
  /// the code and puts it in the approval URL; `/link` verifies it against
  /// this hash before rendering an Approve button, so the page a developer
  /// approves provably came from the URL their own terminal printed. Hashed
  /// because a database read must not recover what the terminal shows. Null
  /// only on rows minted before the column existed, which `/link` refuses.
  userCodeHash String?
  /// Set by `approve` — the profile the signed-in browser session belongs to.
  profileId   String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  approvedAt  DateTime?
  rejectedAt  DateTime?
  completedAt DateTime?

  profile     Profile?  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([status])
}
