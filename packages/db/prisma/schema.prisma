generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String   @id @default(cuid())
  handle      String   @unique
  displayName String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallets     Wallet[]

  @@index([handle])
}

model Wallet {
  id         String   @id @default(cuid())
  profileId  String
  pubkey     String   @unique
  attestedAt DateTime @default(now())
  source     String   @default("curated")
  isPrimary  Boolean  @default(false)

  // Deployment backfill (see apps/indexer/src/workers/deployment.ts). A fresh
  // wallet only ever gets its most recent 200 operations scanned unless this
  // walk exists, which leaves a profile with real deploy history looking
  // empty. operationsCursor is the paging_token the backward (desc) walk has
  // reached so far; null once backfillComplete (nothing left to resume).
  // operationsWatermark is the newest paging_token ever observed for this
  // wallet, captured once on the walk's very first page — it's where the
  // ordinary forward (asc) catch-up scan resumes from once backfill
  // completes, so operations that landed *during* a still-running backfill
  // are never skipped.
  operationsCursor    String?
  operationsWatermark String?
  backfillComplete    Boolean  @default(false)

  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  contracts  Contract[]
  operations Operation[]

  @@index([profileId])
  @@index([pubkey])
}

// Soroban operations (invocations) attributed to a wallet, populated by the
// indexer from Horizon. Powers the activity list on a profile.
model Operation {
  id              String   @id // Horizon operation id (globally unique)
  walletId        String
  type            String
  function        String?
  decodedFunction String?
  sourceAccount   String?
  createdAt       DateTime
  transactionHash String?
  successful      Boolean  @default(true)
  balanceChanges  Json?
  indexedAt       DateTime @default(now())

  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model Contract {
  id              String   @id @default(cuid())
  address         String   @unique
  walletId        String
  deployerPubkey  String
  deployedAt      DateTime
  deployTxHash    String
  network         String   @default("mainnet")
  contractType    String?
  firstIndexedAt  DateTime @default(now())

  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  snapshots       ContractSnapshot[]

  @@index([deployerPubkey])
  @@index([deployedAt])
}

model ContractSnapshot {
  id           String   @id @default(cuid())
  contractId   String
  capturedAt   DateTime @default(now())
  txCount24h   Int      @default(0)
  txCountTotal Int      @default(0)
  lastActivity DateTime?

  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, capturedAt])
}

model IndexerCursor {
  id         String   @id @default("main")
  lastLedger Int      @default(0)
  updatedAt  DateTime @updatedAt
}
