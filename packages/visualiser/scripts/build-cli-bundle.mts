/**
 * @file Build the visualiser bundle the Go CLI embeds (#544).
 *
 *   node --experimental-strip-types packages/visualiser/scripts/build-cli-bundle.mts
 *   node --experimental-strip-types packages/visualiser/scripts/build-cli-bundle.mts --check
 *
 * One self-contained IIFE, ES2019, with no Node or DOM globals (the few the
 * Stellar SDK reaches for are injected from `cli-bundle/shims.ts`), that
 * defines `globalThis.signetVisualise({ specJson, theme, overlays? }) →
 * { svg, decision, wasmHash }` (`src/visualise.ts`). It is written to
 * `cli/internal/visualise/bundle/visualiser.js` and committed, with a header
 * naming the commit it was built from.
 *
 * `--check` rebuilds in memory and fails when the committed bundle's body
 * differs (someone changed the visualiser without rebuilding) or the bundle
 * is over its 2 MB budget. The header is not compared: it names a commit, and
 * the commit that lands a rebuild cannot name itself.
 */

import { execFileSync } from 'node:child_process';
import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, join, relative } from 'node:path';
import { fileURLToPath } from 'node:url';
import { build } from 'esbuild';

const here = dirname(fileURLToPath(import.meta.url));
const root = join(here, '..', '..', '..');
export const BUNDLE_PATH = join(root, 'cli', 'internal', 'visualise', 'bundle', 'visualiser.js');
export const BUDGET_BYTES = 2 * 1024 * 1024;

const ENTRY = `import { visualise } from './src/visualise.ts';
globalThis.signetVisualise = visualise;
`;

/** The bundle's body: deterministic for the same sources. */
export async function bundleBody(): Promise<string> {
  const result = await build({
    stdin: {
      contents: ENTRY,
      resolveDir: join(here, '..'),
      sourcefile: 'cli-entry.ts',
      loader: 'ts',
    },
    bundle: true,
    format: 'iife',
    target: 'es2019',
    platform: 'neutral',
    mainFields: ['module', 'main'],
    inject: [join(here, 'cli-bundle', 'shims.ts')],
    define: { global: 'globalThis', 'process.env.NODE_ENV': '"production"' },
    minify: true,
    legalComments: 'none',
    charset: 'utf8',
    write: false,
    logLevel: 'error',
  });
  return result.outputFiles[0]!.text;
}

function header(): string {
  let commit = 'unknown';
  try {
    commit = execFileSync('git', ['rev-parse', 'HEAD'], { cwd: root, encoding: 'utf8' }).trim();
  } catch {
    // Not a git checkout: say so rather than invent a commit.
  }
  return (
    `// Generated by packages/visualiser/scripts/build-cli-bundle.mts from commit ${commit}.\n` +
    '// Do not edit: rebuild it, and `node scripts/check-visualiser-bundle.mjs` checks it (#544).\n'
  );
}

/** The committed bundle without its header. */
function committedBody(): string {
  const text = readFileSync(BUNDLE_PATH, 'utf8');
  return text.split('\n').slice(2).join('\n');
}

async function main(): Promise<void> {
  const body = await bundleBody();
  const size = Buffer.byteLength(body);
  const shown = relative(root, BUNDLE_PATH);
  if (size > BUDGET_BYTES) {
    console.error(`${shown}: ${size} bytes, over the ${BUDGET_BYTES}-byte budget`);
    process.exit(1);
  }
  if (process.argv.includes('--check')) {
    let committed: string;
    try {
      committed = committedBody();
    } catch {
      console.error(
        `${shown} is missing; build it with packages/visualiser/scripts/build-cli-bundle.mts`,
      );
      process.exit(1);
    }
    if (committed !== body) {
      console.error(
        `${shown} is out of date with packages/visualiser.\n` +
          'Rebuild it: node --experimental-strip-types packages/visualiser/scripts/build-cli-bundle.mts',
      );
      process.exit(1);
    }
    console.log(`${shown} is up to date (${size} bytes, budget ${BUDGET_BYTES}).`);
    return;
  }
  mkdirSync(dirname(BUNDLE_PATH), { recursive: true });
  writeFileSync(BUNDLE_PATH, header() + body);
  console.log(`wrote ${shown}: ${size} bytes (budget ${BUDGET_BYTES})`);
}

if (import.meta.url === `file://${process.argv[1]}`) await main();
