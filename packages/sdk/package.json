{
  "name": "@signet/sdk",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Read-only client for the Signet API — fetch a developer's verifiable Stellar/Soroban career record by handle.",
  "keywords": [
    "signet",
    "stellar",
    "soroban",
    "web3",
    "developer-profile",
    "sdk"
  ],
  "homepage": "https://github.com/blockchain-maxis/signet/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blockchain-maxis/signet.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/blockchain-maxis/signet/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser/signet.min.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config ../../eslint.config.js",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "generate": "node scripts/generate-v1.mjs",
    "generate:check": "node scripts/generate-v1.mjs --check",
    "check:size": "node scripts/check-size.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "smoke:node": "node scripts/smoke-node.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.3"
  }
}
