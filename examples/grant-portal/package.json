{
  "name": "grant-portal-example",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Example integration: verify a grant applicant's Signet handle and claimed contract with @signet/sdk.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "node --conditions=development --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config ../../eslint.config.js",
    "test": "node --conditions=development --experimental-strip-types --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@signet/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "typescript": "^5.6.3"
  }
}
