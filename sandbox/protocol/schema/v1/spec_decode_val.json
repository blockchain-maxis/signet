{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://signet.dev/schemas/sandbox/v1/spec_decode_val.json",
  "title": "spec_decode_val (request)",
  "description": "Decode XDR to JSON with a contract's spec: a function's return value (val_xdr + function), a value of a named type (val_xdr + as_type), or a contract event (event_xdr). The JSON shape is the one spec_encode_args accepts; a failed Result decodes to {\"error\": {code, name, enum, doc, candidates?}}.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1,
      "description": "Wire protocol version; checked on every message"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Caller-assigned; echoed on the response"
    },
    "type": {
      "const": "spec_decode_val"
    },
    "source": {
      "description": "A contract executable, by value or by installed contract",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "wasm_base64": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9+/]+={0,2}$",
              "description": "The WASM executable, base64"
            }
          },
          "required": ["wasm_base64"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract_id": {
              "type": "string",
              "minLength": 1,
              "description": "An installed contract id (C...)"
            }
          },
          "required": ["contract_id"],
          "additionalProperties": false
        }
      ]
    },
    "function": {
      "type": "string",
      "minLength": 1,
      "description": "Decode val_xdr as this function's return type"
    },
    "val_xdr": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
      "description": "ScVal, base64 XDR"
    },
    "as_type": {
      "type": "string",
      "minLength": 1,
      "description": "Decode val_xdr as this user-defined type instead of a function's return type"
    },
    "event_xdr": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
      "description": "ContractEvent, base64 XDR: decoded by the contract's event spec when one matches"
    }
  },
  "required": ["version", "id", "type", "source"],
  "additionalProperties": false,
  "definitions": {
    "result": {
      "title": "spec_decode_val (success response)",
      "type": "object",
      "properties": {
        "version": {
          "const": 1,
          "description": "Wire protocol version; checked on every message"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Echoes the id of the spec_decode_val request"
        },
        "type": {
          "const": "result"
        },
        "value": {
          "description": "The decoded value, as JSON"
        }
      },
      "required": ["version", "id", "type", "value"],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "properties": {
        "val_xdr": true,
        "function": true
      },
      "required": ["val_xdr", "function"]
    },
    {
      "properties": {
        "val_xdr": true,
        "as_type": true
      },
      "required": ["val_xdr", "as_type"]
    },
    {
      "properties": {
        "event_xdr": true
      },
      "required": ["event_xdr"]
    }
  ]
}
