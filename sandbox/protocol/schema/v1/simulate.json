{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://signet.dev/schemas/sandbox/v1/simulate.json",
  "title": "simulate (request)",
  "description": "Run a contract function against the open ledger (#534). Arguments are JSON; the simulator encodes them from the contract spec (#545).",
  "type": "object",
  "properties": {
    "version": {
      "const": 1,
      "description": "Wire protocol version; checked on every message"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Caller-assigned; echoed on the response"
    },
    "type": {
      "const": "simulate"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "description": "Installed contract id"
    },
    "function": {
      "type": "string",
      "minLength": 1,
      "description": "Function name"
    },
    "args": {
      "description": "Arguments as JSON in @signet/spec's functionArgsSchema shape: an object keyed by argument name, or an array in declaration order",
      "oneOf": [
        {
          "type": "array",
          "items": true
        },
        {
          "type": "object"
        }
      ]
    },
    "args_xdr": {
      "description": "The arguments as ScVal base64 XDR, in order, instead of args: a real transaction replayed exactly as it sent them (#636). Not both.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9+/]+={0,2}$"
      }
    },
    "source_account": {
      "type": "string",
      "minLength": 1,
      "description": "Invoking account (G...); a default is used if omitted"
    },
    "diagnostics": {
      "type": "boolean",
      "description": "Record diagnostic events (default false)"
    },
    "trace": {
      "description": "Return the call tree (#541): true, or {max_frames} to cap it (default 10000; truncation is flagged)",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "max_frames": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "call_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Run with the PRNG seed of this call index in the session, without advancing the session's count: the same call run twice (signet dev's deployed and new code, #566) draws the same seed"
    },
    "related": {
      "type": "boolean",
      "description": "false keeps the call to this contract: reading another contract's instance fails with fetch_failed / related, naming it (#552). Default true"
    },
    "dry_run": {
      "type": "boolean",
      "description": "Do not apply the call's writes to the session (default false)"
    },
    "budget": {
      "type": "object",
      "description": "Budget overrides, each up to 10x the network's limit (#536); running out is a host contract_error",
      "properties": {
        "instructions": {
          "type": "integer",
          "minimum": 1
        },
        "mem_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "unlimited": {
          "type": "boolean",
          "description": "A limit not given is the 10x ceiling, not the network's (#558)"
        }
      },
      "additionalProperties": false
    },
    "ledger": {
      "type": "object",
      "description": "Run this call at another ledger than the session's (#558): later entries' TTLs and archival follow it; the session's own ledger is unchanged",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "description": "Unix seconds"
        }
      },
      "additionalProperties": false
    },
    "auth_mode": {
      "enum": ["record", "strict", "enforce"],
      "description": "record (default): approve every require_auth and record it, signatures not checked; strict: record but refuse auth below the root invocation; enforce: check auth_entries (#557)"
    },
    "auth_entries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9+/]+={0,2}$"
      },
      "description": "Pre-signed SorobanAuthorizationEntry XDR, for enforce"
    },
    "adjustment": {
      "enum": ["none", "rpc"],
      "description": "rpc pads resources and the fee as RPC's simulateTransaction does by default (instructions \u00d71.04 + 50000, tx size \u00d71.1 + 500, refundable fee \u00d71.15), for comparing with it (#575); none (the default) reports what the call used"
    }
  },
  "required": ["version", "id", "type", "contract_id", "function", "args"],
  "additionalProperties": false,
  "definitions": {
    "result": {
      "title": "simulate (success response)",
      "type": "object",
      "properties": {
        "version": {
          "const": 1,
          "description": "Wire protocol version; checked on every message"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Echoes the id of the simulate request"
        },
        "type": {
          "const": "result"
        },
        "return_value_xdr": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "description": "The returned ScVal, base64 XDR"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "description": "contract | system | diagnostic"
              },
              "event_xdr": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                "description": "ContractEvent, base64 XDR"
              },
              "decoded": {
                "type": "object",
                "description": "The event decoded with the contract's spec (#546)"
              }
            },
            "required": ["type", "event_xdr"],
            "additionalProperties": false
          }
        },
        "cost": {
          "type": "object",
          "properties": {
            "cpu_insns": {
              "type": "integer",
              "description": "CPU instructions",
              "minimum": 0
            },
            "mem_bytes": {
              "type": "integer",
              "description": "Memory bytes",
              "minimum": 0
            }
          },
          "required": ["cpu_insns", "mem_bytes"],
          "additionalProperties": false
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "return_value": {
          "description": "The return value decoded with the contract's spec (#546), when it decodes"
        },
        "diagnostic_events": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$",
            "description": "DiagnosticEvent"
          }
        },
        "auth": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$",
            "description": "SorobanAuthorizationEntry recorded for the call"
          }
        },
        "modified_entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key_xdr": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                "description": "LedgerKey"
              },
              "before_xdr": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                    "description": "LedgerEntry before the call"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "after_xdr": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                    "description": "LedgerEntry after the call"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "live_until_ledger": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The entry's TTL after the call"
              }
            },
            "required": ["key_xdr", "before_xdr", "after_xdr"],
            "additionalProperties": false
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "instructions": {
              "type": "integer",
              "minimum": 0
            },
            "disk_read_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "write_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "footprint": {
              "type": "object",
              "properties": {
                "read_only": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                    "description": "LedgerKey"
                  }
                },
                "read_write": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                    "description": "LedgerKey"
                  }
                }
              },
              "required": ["read_only", "read_write"],
              "additionalProperties": false
            }
          },
          "required": ["instructions", "disk_read_bytes", "write_bytes", "footprint"],
          "additionalProperties": false,
          "description": "From the simulated SorobanTransactionData, unadjusted"
        },
        "fee": {
          "type": "object",
          "properties": {
            "resource_fee": {
              "type": "integer",
              "description": "Raw resource fee in stroops, with no adjustment (RPC pads by default)"
            }
          },
          "required": ["resource_fee"],
          "additionalProperties": false
        },
        "misses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$",
            "description": "LedgerKey fetched from Go during this call (#531)"
          },
          "description": "Keys the call fetched, in order: what Go can prefetch next time (#552)"
        },
        "ledger": {
          "type": "object",
          "description": "The ledger the call ran against",
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "timestamp": {
              "type": "integer",
              "minimum": 0
            },
            "protocol": {
              "type": "integer",
              "minimum": 1
            },
            "overridden": {
              "const": true,
              "description": "The call ran at a sequence or timestamp other than the session's (#558)"
            }
          },
          "required": ["sequence", "timestamp", "protocol"],
          "additionalProperties": false
        },
        "seed": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The call's PRNG seed: sha256(session_id \u2016 call index as a big-endian u64) (#537)"
        },
        "budget": {
          "type": "object",
          "description": "The limits an overridden call ran under (#536); absent when it ran under the network's",
          "properties": {
            "instructions": {
              "type": "integer",
              "minimum": 1
            },
            "mem_bytes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["instructions", "mem_bytes"],
          "additionalProperties": false
        },
        "auth_entries": {
          "type": "array",
          "description": "The recorded auth entries in plain terms, in the order of `auth`",
          "items": {
            "type": "object",
            "properties": {
              "credentials": {
                "enum": ["source_account", "address", "address_v2", "address_with_delegates"]
              },
              "address": {
                "type": "string",
                "description": "Whose signature the entry needs"
              },
              "root_function": {
                "type": "object",
                "description": "What it authorizes: {kind: contract_fn, contract_id, function} or a create-contract kind"
              },
              "sub_invocations": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": ["credentials", "root_function", "sub_invocations"],
            "additionalProperties": false
          }
        },
        "auth_mode": {
          "enum": ["record", "strict", "enforce"],
          "description": "How require_auth was answered (#557)"
        },
        "archived": {
          "type": "array",
          "description": "Archived entries the call read (#558): a persistent one is restored by the call, as the network does from protocol 23; an expired temporary one reads as absent",
          "items": {
            "type": "object",
            "properties": {
              "key_xdr": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                "description": "LedgerKey"
              },
              "key": {
                "type": "string",
                "description": "The key in plain terms"
              },
              "live_until_ledger": {
                "type": "integer",
                "minimum": 0,
                "description": "The ledger its TTL ran out after"
              },
              "outcome": {
                "enum": ["restored", "expired"]
              }
            },
            "required": ["key_xdr", "key", "live_until_ledger", "outcome"],
            "additionalProperties": false
          }
        },
        "trace": {
          "type": "object",
          "description": "The call tree, when the request asked for `trace` (#541); its shape is trace.json"
        },
        "contracts": {
          "type": "array",
          "description": "The other contracts the call reached, by reading their instance, in the order it reached them (#552)",
          "items": {
            "type": "object",
            "properties": {
              "contract_id": {
                "type": "string",
                "pattern": "^C[A-Z2-7]{55}$"
              },
              "executable": {
                "enum": ["wasm", "stellar_asset", "external_ref"]
              },
              "asset": {
                "type": "string",
                "minLength": 1,
                "description": "A Stellar Asset Contract's asset: native, or CODE:ISSUER"
              }
            },
            "required": ["contract_id"],
            "additionalProperties": false
          }
        }
      },
      "required": ["version", "id", "type", "return_value_xdr", "events", "cost", "logs"],
      "additionalProperties": false
    }
  }
}
