{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://signet.dev/schemas/sandbox/v1/status.json",
  "title": "status (request)",
  "description": "Report the simulator state, for diagnostics and for Go to rebuild after a restart.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1,
      "description": "Wire protocol version; checked on every message"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Caller-assigned; echoed on the response"
    },
    "type": {
      "const": "status"
    }
  },
  "required": ["version", "id", "type"],
  "additionalProperties": false,
  "definitions": {
    "result": {
      "title": "status (success response)",
      "type": "object",
      "properties": {
        "version": {
          "const": 1,
          "description": "Wire protocol version; checked on every message"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Echoes the id of the status request"
        },
        "type": {
          "const": "result"
        },
        "uptime_ms": {
          "type": "integer",
          "description": "Milliseconds since start",
          "minimum": 0
        },
        "ledger_open": {
          "type": "boolean"
        },
        "ledger_sequence": {
          "oneOf": [
            {
              "type": "integer",
              "description": "Open ledger sequence",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "entries": {
          "type": "integer",
          "description": "Entries in the open ledger",
          "minimum": 0
        },
        "contracts": {
          "type": "integer",
          "description": "Installed contracts",
          "minimum": 0
        }
      },
      "required": [
        "version",
        "id",
        "type",
        "uptime_ms",
        "ledger_open",
        "ledger_sequence",
        "entries",
        "contracts"
      ],
      "additionalProperties": false
    }
  }
}
