{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://signet.dev/schemas/sandbox/v1/spec_encode_args.json",
  "title": "spec_encode_args (request)",
  "description": "Encode JSON arguments to ScVals using a contract spec, without running anything.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1,
      "description": "Wire protocol version; checked on every message"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Caller-assigned; echoed on the response"
    },
    "type": {
      "const": "spec_encode_args"
    },
    "source": {
      "description": "A contract executable, by value or by installed contract",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "wasm_base64": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9+/]+={0,2}$",
              "description": "The WASM executable, base64"
            }
          },
          "required": ["wasm_base64"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract_id": {
              "type": "string",
              "minLength": 1,
              "description": "An installed contract id (C...)"
            }
          },
          "required": ["contract_id"],
          "additionalProperties": false
        }
      ]
    },
    "function": {
      "type": "string",
      "minLength": 1,
      "description": "Function name"
    },
    "args": {
      "type": "array",
      "items": true,
      "description": "Arguments as JSON values"
    }
  },
  "required": ["version", "id", "type", "source", "function", "args"],
  "additionalProperties": false,
  "definitions": {
    "result": {
      "title": "spec_encode_args (success response)",
      "type": "object",
      "properties": {
        "version": {
          "const": 1,
          "description": "Wire protocol version; checked on every message"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Echoes the id of the spec_encode_args request"
        },
        "type": {
          "const": "result"
        },
        "args_xdr": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$",
            "description": "ScVal, base64 XDR"
          }
        }
      },
      "required": ["version", "id", "type", "args_xdr"],
      "additionalProperties": false
    }
  }
}
