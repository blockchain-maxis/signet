{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://signet.dev/schemas/sandbox/v1/ledger_put.json",
  "title": "ledger_put (request)",
  "description": "Write entries into the open ledger.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1,
      "description": "Wire protocol version; checked on every message"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Caller-assigned; echoed on the response"
    },
    "type": {
      "const": "ledger_put"
    },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "key_xdr": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                "description": "LedgerKey, base64 XDR"
              },
              "entry_xdr": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                "description": "LedgerEntry, base64 XDR"
              },
              "live_until_ledger": {
                "type": "integer",
                "description": "Last ledger the entry is live, for entries that expire",
                "minimum": 0
              }
            },
            "required": ["key_xdr", "entry_xdr"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key_xdr": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                "description": "LedgerKey"
              },
              "data_xdr": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                "description": "LedgerEntryData, as RPC getLedgerEntries returns it in `xdr`"
              },
              "last_modified_ledger_seq": {
                "type": "integer",
                "minimum": 0,
                "description": "RPC's lastModifiedLedgerSeq"
              },
              "ext_xdr": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                    "description": "LedgerEntryExt, RPC's extXdr"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "live_until_ledger": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["key_xdr", "data_xdr", "last_modified_ledger_seq"],
            "additionalProperties": false,
            "description": "An entry in the pieces RPC returns; the simulator assembles the LedgerEntry, so Go never builds XDR"
          }
        ]
      },
      "description": "Entries to write",
      "minItems": 1
    }
  },
  "required": ["version", "id", "type", "entries"],
  "additionalProperties": false,
  "definitions": {
    "result": {
      "title": "ledger_put (success response)",
      "type": "object",
      "properties": {
        "version": {
          "const": 1,
          "description": "Wire protocol version; checked on every message"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Echoes the id of the ledger_put request"
        },
        "type": {
          "const": "result"
        },
        "written": {
          "type": "integer",
          "description": "Entries written",
          "minimum": 0
        }
      },
      "required": ["version", "id", "type", "written"],
      "additionalProperties": false
    }
  }
}
