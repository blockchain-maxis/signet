{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://signet.dev/schemas/sandbox/v1/contract_error.json",
  "title": "contract_error",
  "description": "The call itself failed. A well-formed answer to a successful request cycle, never a simulator failure.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1,
      "description": "Wire protocol version; checked on every message"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Echoes the request id"
    },
    "type": {
      "const": "contract_error"
    },
    "kind": {
      "enum": ["contract", "host"],
      "description": "contract: a contracterror the contract returned. host: a trap, budget exhaustion or other host error."
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "description": "Host error code, or the contract error name"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable explanation"
    },
    "decoded": {
      "type": "object",
      "description": "Fields decoded from the contract spec when kind is contract (#546)",
      "properties": {
        "error_enum": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the contract error enum"
        },
        "error_name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the case"
        },
        "error_value": {
          "type": "integer",
          "description": "Numeric value of the case",
          "minimum": 0
        },
        "error_doc": {
          "type": "string",
          "minLength": 1,
          "description": "Doc comment of the case"
        },
        "candidates": {
          "type": "array",
          "description": "Every error-enum case at this code, when more than one enum has one",
          "items": {
            "type": "object",
            "properties": {
              "error_enum": {
                "type": "string"
              },
              "error_name": {
                "type": "string"
              },
              "error_doc": {
                "type": "string"
              }
            },
            "required": ["error_enum", "error_name"],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "diagnostic_events": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9+/]+={0,2}$",
        "description": "ContractEvent, base64 XDR"
      },
      "description": "Diagnostic events recorded before the failure"
    },
    "cost": {
      "type": "object",
      "properties": {
        "cpu_insns": {
          "type": "integer",
          "minimum": 0
        },
        "mem_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["cpu_insns", "mem_bytes"],
      "additionalProperties": false
    },
    "misses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9+/]+={0,2}$",
        "description": "LedgerKey fetched from Go during this call (#531)"
      },
      "description": "Keys the call fetched, in order: what Go can prefetch next time (#552)"
    },
    "ledger": {
      "type": "object",
      "description": "The ledger the call ran against",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        },
        "protocol": {
          "type": "integer",
          "minimum": 1
        },
        "overridden": {
          "const": true,
          "description": "The call ran at a sequence or timestamp other than the session's (#558)"
        }
      },
      "required": ["sequence", "timestamp", "protocol"],
      "additionalProperties": false
    },
    "seed": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "The call's PRNG seed: sha256(session_id ‖ call index as a big-endian u64) (#537)"
    },
    "budget": {
      "type": "object",
      "description": "The limits an overridden call ran under (#536); absent when it ran under the network's",
      "properties": {
        "instructions": {
          "type": "integer",
          "minimum": 1
        },
        "mem_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["instructions", "mem_bytes"],
      "additionalProperties": false
    },
    "auth_mode": {
      "enum": ["record", "strict", "enforce"],
      "description": "How require_auth was answered (#557)"
    },
    "archived": {
      "type": "array",
      "description": "Archived entries the call read (#558): a persistent one is restored by the call, as the network does from protocol 23; an expired temporary one reads as absent",
      "items": {
        "type": "object",
        "properties": {
          "key_xdr": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$",
            "description": "LedgerKey"
          },
          "key": {
            "type": "string",
            "description": "The key in plain terms"
          },
          "live_until_ledger": {
            "type": "integer",
            "minimum": 0,
            "description": "The ledger its TTL ran out after"
          },
          "outcome": {
            "enum": ["restored", "expired"]
          }
        },
        "required": ["key_xdr", "key", "live_until_ledger", "outcome"],
        "additionalProperties": false
      }
    },
    "trace": {
      "type": "object",
      "description": "The call tree, when the request asked for `trace` (#541); its shape is trace.json"
    },
    "contracts": {
      "type": "array",
      "description": "The other contracts the call reached, by reading their instance, in the order it reached them (#552)",
      "items": {
        "type": "object",
        "properties": {
          "contract_id": {
            "type": "string",
            "pattern": "^C[A-Z2-7]{55}$"
          },
          "executable": {
            "enum": ["wasm", "stellar_asset", "external_ref"]
          },
          "asset": {
            "type": "string",
            "minLength": 1,
            "description": "A Stellar Asset Contract's asset: native, or CODE:ISSUER"
          }
        },
        "required": ["contract_id"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "id", "type", "kind", "code", "message", "diagnostic_events"],
  "additionalProperties": false
}
