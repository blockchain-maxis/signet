{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://signet.dev/schemas/sandbox/v1/spec_diff.json",
  "title": "spec_diff (request)",
  "description": "Compare the interfaces of two executables (#570): each change classed breaking, compatible or info, as @signet/spec's diffSpecs sees it plus CAP-86's rule for added struct fields.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1,
      "description": "Wire protocol version; checked on every message"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Caller-assigned; echoed on the response"
    },
    "type": {
      "const": "spec_diff"
    },
    "old": {
      "description": "A contract executable, by value or by installed contract",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "wasm_base64": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9+/]+={0,2}$",
              "description": "The WASM executable, base64"
            }
          },
          "required": ["wasm_base64"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract_id": {
              "type": "string",
              "minLength": 1,
              "description": "An installed contract id (C...)"
            }
          },
          "required": ["contract_id"],
          "additionalProperties": false
        }
      ]
    },
    "new": {
      "description": "A contract executable, by value or by installed contract",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "wasm_base64": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9+/]+={0,2}$",
              "description": "The WASM executable, base64"
            }
          },
          "required": ["wasm_base64"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract_id": {
              "type": "string",
              "minLength": 1,
              "description": "An installed contract id (C...)"
            }
          },
          "required": ["contract_id"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["version", "id", "type", "old", "new"],
  "additionalProperties": false,
  "definitions": {
    "result": {
      "title": "spec_diff (success response)",
      "type": "object",
      "properties": {
        "version": {
          "const": 1,
          "description": "Wire protocol version; checked on every message"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Echoes the id of the spec_diff request"
        },
        "type": {
          "const": "result"
        },
        "compatible": {
          "type": "boolean",
          "description": "No change is breaking"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "description": "diffSpecs' change kinds (function-removed, field-added, \u2026), and sdk-version-changed, rust-version-changed, interface-version-changed"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Where in the SpecJson: functions.claim.inputs.wallet, types.Profile.fields.age, errors.Error.HandleTaken"
              },
              "class": {
                "enum": ["breaking", "compatible", "info"]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "rule": {
                "enum": ["strict", "cap86-sparse-option", "cap86-sparse-required"],
                "description": "For an added struct field: how stored values without it decode"
              },
              "storage_note": {
                "type": "string",
                "description": "What the rule means for stored values"
              },
              "before": {},
              "after": {}
            },
            "required": ["kind", "path", "class", "reason"],
            "additionalProperties": false
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "breaking": {
              "type": "integer",
              "minimum": 0
            },
            "compatible": {
              "type": "integer",
              "minimum": 0
            },
            "info": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["breaking", "compatible", "info"],
          "additionalProperties": false
        },
        "sdk_versions": {
          "type": "object",
          "properties": {
            "old": {
              "type": ["string", "null"]
            },
            "new": {
              "type": ["string", "null"]
            }
          },
          "required": ["old", "new"],
          "additionalProperties": false,
          "description": "rssdkver from each executable's contractmetav0"
        },
        "sparse_decoding": {
          "type": "boolean",
          "description": "The new build imports CAP-86's sparse_map_unpack_to_linear_memory"
        }
      },
      "required": [
        "version",
        "id",
        "type",
        "compatible",
        "summary",
        "sdk_versions",
        "sparse_decoding",
        "changes"
      ],
      "additionalProperties": false
    }
  }
}
