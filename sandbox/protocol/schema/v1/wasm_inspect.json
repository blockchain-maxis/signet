{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://signet.dev/schemas/sandbox/v1/wasm_inspect.json",
  "title": "wasm_inspect (request)",
  "description": "Report what an executable declares, without running it (#532, used by #540).",
  "type": "object",
  "properties": {
    "version": {
      "const": 1,
      "description": "Wire protocol version; checked on every message"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Caller-assigned; echoed on the response"
    },
    "type": {
      "const": "wasm_inspect"
    },
    "ledger_protocol": {
      "type": "integer",
      "minimum": 0,
      "description": "Lane to decode with; defaults to the open ledger's, else the newest"
    },
    "wasm_base64": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
      "description": "The WASM executable, base64"
    }
  },
  "required": ["version", "id", "type", "wasm_base64"],
  "additionalProperties": false,
  "definitions": {
    "result": {
      "title": "wasm_inspect (success response)",
      "type": "object",
      "properties": {
        "version": {
          "const": 1,
          "description": "Wire protocol version; checked on every message"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Echoes the id of the wasm_inspect request"
        },
        "type": {
          "const": "result"
        },
        "wasm_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256, hex"
        },
        "size_bytes": {
          "type": "integer",
          "description": "Executable size",
          "minimum": 0
        },
        "custom_sections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every custom section's name, in file order (a name may repeat)"
        },
        "interface_version": {
          "description": "contractenvmetav0's interface version; null when the section declares none",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "protocol": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Ledger protocol the executable targets"
                },
                "pre_release": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Pre-release number; 0 for anything that can run on a network"
                }
              },
              "required": ["protocol", "pre_release"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "exports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Exported function names, in file order"
        },
        "imports": {
          "type": "array",
          "description": "Imported functions, in file order: the host functions the executable calls",
          "items": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": ["module", "name"],
            "additionalProperties": false
          }
        },
        "upgradeable": {
          "enum": ["wasm", "executable-ref", "none"],
          "description": "Whether the executable can replace its own code on-chain (#540): it imports update_current_contract_wasm (l.6) or, from protocol 28, update_current_contract_executable_ref (l.j). A contract upgraded from outside, through a proxy or factory, reports none."
        }
      },
      "required": [
        "version",
        "id",
        "type",
        "wasm_hash",
        "size_bytes",
        "custom_sections",
        "interface_version",
        "exports",
        "imports",
        "upgradeable"
      ],
      "additionalProperties": false
    }
  }
}
