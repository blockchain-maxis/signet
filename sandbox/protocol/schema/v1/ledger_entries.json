{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://signet.dev/schemas/sandbox/v1/ledger_entries.json",
  "title": "ledger_entries (Go to simulator)",
  "description": "Go's answer to a ledger_fetch. Entries it could not find come back as null.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1,
      "description": "Wire protocol version; checked on every message"
    },
    "id": {
      "type": "string",
      "pattern": "^sim-.+$"
    },
    "type": {
      "const": "ledger_entries"
    },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "key_xdr": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                "description": "Requested key"
              },
              "entry_xdr": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                    "description": "Entry"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "live_until_ledger": {
                "oneOf": [
                  {
                    "type": "integer",
                    "description": "Live until",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["key_xdr", "entry_xdr"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key_xdr": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                "description": "LedgerKey"
              },
              "data_xdr": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                "description": "LedgerEntryData, as RPC getLedgerEntries returns it in `xdr`"
              },
              "last_modified_ledger_seq": {
                "type": "integer",
                "minimum": 0,
                "description": "RPC's lastModifiedLedgerSeq"
              },
              "ext_xdr": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                    "description": "LedgerEntryExt, RPC's extXdr"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "live_until_ledger": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["key_xdr", "data_xdr", "last_modified_ledger_seq"],
            "additionalProperties": false,
            "description": "An entry in the pieces RPC returns; the simulator assembles the LedgerEntry, so Go never builds XDR"
          }
        ]
      }
    }
  },
  "required": ["version", "id", "type", "entries"],
  "additionalProperties": false
}
