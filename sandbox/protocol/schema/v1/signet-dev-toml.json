{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://signet.dev/schemas/sandbox/v1/signet-dev-toml.json",
  "title": "signet.dev.toml",
  "description": "A contract's saved calls, replay settings, diff rules and storage overrides (#560), as signet.dev.toml holds them. Not a wire message: for editors (Taplo) and the CLI's own checks. See docs/SANDBOX.md.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "network": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "rpc_url": {
              "type": "string",
              "minLength": 1
            },
            "passphrase": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "address": {
      "type": "string",
      "pattern": "^C[A-Z2-7]{55}$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "package": {
      "type": "string",
      "minLength": 1
    },
    "replay": {
      "type": "object",
      "properties": {
        "saved": {
          "type": "boolean"
        },
        "recent_transactions": {
          "type": "integer",
          "minimum": 0
        },
        "include_failed": {
          "type": "boolean"
        },
        "fail_on_low_fidelity": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "call": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "function": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "args": {
            "type": "object"
          },
          "expect": {
            "type": "string",
            "pattern": "^(unchanged|ok|any|error:[A-Za-z_][A-Za-z0-9_]*)$"
          },
          "chain": {
            "type": "boolean",
            "description": "Start from the previous call's end state, on both sides, instead of from the fork (#567); not on the first call"
          },
          "seed": {
            "type": "boolean",
            "description": "With signet dev --localnet-seed, also run this call as a real transaction on the local network after each fresh deploy (#590)"
          }
        },
        "required": ["name", "function", "expect"],
        "additionalProperties": false
      }
    },
    "override": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "durability": {
            "enum": ["instance", "persistent", "temporary"]
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "unset": {
            "type": "boolean"
          }
        },
        "required": ["durability", "key"],
        "additionalProperties": false
      }
    },
    "diff": {
      "type": "object",
      "properties": {
        "ignore_events": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^/]+(/[^/]+)*$"
          },
          "description": "Event topic prefixes a diff leaves out: topic texts separated by /"
        },
        "ignore_storage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Storage key patterns a diff leaves out: the --set-storage key syntax, * for any value"
        },
        "ignore_auth": {
          "type": "boolean",
          "description": "Leave auth changes out (they break signed payloads; signet dev warns)"
        },
        "resource_tolerance": {
          "type": "object",
          "properties": {
            "instructions": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?%|[0-9]+)$"
            },
            "mem_bytes": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?%|[0-9]+)$"
            },
            "read_bytes": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?%|[0-9]+)$"
            },
            "write_bytes": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?%|[0-9]+)$"
            },
            "read_entries": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?%|[0-9]+)$"
            },
            "write_entries": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?%|[0-9]+)$"
            },
            "fee": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?%|[0-9]+)$"
            }
          },
          "additionalProperties": false,
          "description": "How far a resource may move before it counts: a percentage (\"10%\") or an amount (\"500\")"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["version"],
  "additionalProperties": false
}
