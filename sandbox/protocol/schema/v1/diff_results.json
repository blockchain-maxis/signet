{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://signet.dev/schemas/sandbox/v1/diff_results.json",
  "title": "diff_results (request)",
  "description": "Compare a call's result on the deployed code (a) and on a new build (b): outcome, return value, events, storage writes, auth and resources (#568), each difference classed under the rules (#569). Values are compared as XDR, so u64 1 and i128 1 differ.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1,
      "description": "Wire protocol version; checked on every message"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Caller-assigned; echoed on the response"
    },
    "type": {
      "const": "diff_results"
    },
    "ledger_protocol": {
      "type": "integer",
      "minimum": 0,
      "description": "The lane that decodes the XDR; default the open ledger's, else the newest"
    },
    "a": {
      "type": "object",
      "description": "One side: what a simulate (or contract_error) reply carried, as Go passes it on",
      "properties": {
        "outcome": {
          "enum": ["ok", "error"],
          "description": "ok: the call returned; error: it ended in a contract_error"
        },
        "error": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "description": "contract or host"
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "description": "The contract_error's code"
            }
          },
          "required": ["kind", "code"],
          "additionalProperties": false
        },
        "return_value_xdr": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "description": "The returned ScVal; required when outcome is ok"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "description": "contract | system | diagnostic (diagnostic events are left out)"
              },
              "event_xdr": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                "description": "ContractEvent"
              }
            },
            "required": ["type", "event_xdr"],
            "additionalProperties": true
          }
        },
        "storage": {
          "type": "array",
          "description": "The entries the call wrote (simulate's modified_entries)",
          "items": {
            "type": "object",
            "properties": {
              "key_xdr": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                "description": "LedgerKey"
              },
              "entry_xdr": {
                "type": ["string", "null"],
                "description": "The LedgerEntry the call left; null when it deleted the entry"
              },
              "live_until_ledger": {
                "type": ["integer", "null"],
                "minimum": 0
              }
            },
            "required": ["key_xdr"],
            "additionalProperties": false
          }
        },
        "auth": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$",
            "description": "SorobanAuthorizationEntry"
          },
          "description": "The recorded auth entries"
        },
        "resources": {
          "type": "object",
          "properties": {
            "instructions": {
              "type": "integer",
              "minimum": 0
            },
            "mem_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "read_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "write_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "read_entries": {
              "type": "integer",
              "minimum": 0
            },
            "write_entries": {
              "type": "integer",
              "minimum": 0
            },
            "resource_fee": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "description": "Metrics compared when both sides give them"
        }
      },
      "required": ["outcome"],
      "additionalProperties": false
    },
    "b": {
      "type": "object",
      "description": "One side: what a simulate (or contract_error) reply carried, as Go passes it on",
      "properties": {
        "outcome": {
          "enum": ["ok", "error"],
          "description": "ok: the call returned; error: it ended in a contract_error"
        },
        "error": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "description": "contract or host"
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "description": "The contract_error's code"
            }
          },
          "required": ["kind", "code"],
          "additionalProperties": false
        },
        "return_value_xdr": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "description": "The returned ScVal; required when outcome is ok"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "description": "contract | system | diagnostic (diagnostic events are left out)"
              },
              "event_xdr": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                "description": "ContractEvent"
              }
            },
            "required": ["type", "event_xdr"],
            "additionalProperties": true
          }
        },
        "storage": {
          "type": "array",
          "description": "The entries the call wrote (simulate's modified_entries)",
          "items": {
            "type": "object",
            "properties": {
              "key_xdr": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                "description": "LedgerKey"
              },
              "entry_xdr": {
                "type": ["string", "null"],
                "description": "The LedgerEntry the call left; null when it deleted the entry"
              },
              "live_until_ledger": {
                "type": ["integer", "null"],
                "minimum": 0
              }
            },
            "required": ["key_xdr"],
            "additionalProperties": false
          }
        },
        "auth": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$",
            "description": "SorobanAuthorizationEntry"
          },
          "description": "The recorded auth entries"
        },
        "resources": {
          "type": "object",
          "properties": {
            "instructions": {
              "type": "integer",
              "minimum": 0
            },
            "mem_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "read_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "write_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "read_entries": {
              "type": "integer",
              "minimum": 0
            },
            "write_entries": {
              "type": "integer",
              "minimum": 0
            },
            "resource_fee": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "description": "Metrics compared when both sides give them"
        }
      },
      "required": ["outcome"],
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "description": "What the diff leaves out or tolerates (#569), from signet.dev.toml's [diff]",
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1,
          "description": "The contract whose spec reads ignore_storage's enum cases; needs an open ledger"
        },
        "ignore_events": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Event topic prefixes: topic texts separated by /"
        },
        "ignore_storage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Storage key patterns: the storage_override key syntax, * for any value"
        },
        "ignore_auth": {
          "type": "boolean",
          "description": "Class auth differences ignored"
        },
        "resource_tolerance": {
          "type": "object",
          "properties": {
            "instructions": {
              "type": "object",
              "properties": {
                "percent": {
                  "type": "number",
                  "minimum": 0
                },
                "absolute": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "mem_bytes": {
              "type": "object",
              "properties": {
                "percent": {
                  "type": "number",
                  "minimum": 0
                },
                "absolute": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "read_bytes": {
              "type": "object",
              "properties": {
                "percent": {
                  "type": "number",
                  "minimum": 0
                },
                "absolute": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "write_bytes": {
              "type": "object",
              "properties": {
                "percent": {
                  "type": "number",
                  "minimum": 0
                },
                "absolute": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "read_entries": {
              "type": "object",
              "properties": {
                "percent": {
                  "type": "number",
                  "minimum": 0
                },
                "absolute": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "write_entries": {
              "type": "object",
              "properties": {
                "percent": {
                  "type": "number",
                  "minimum": 0
                },
                "absolute": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "resource_fee": {
              "type": "object",
              "properties": {
                "percent": {
                  "type": "number",
                  "minimum": 0
                },
                "absolute": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "description": "Per metric: a move within percent of A's, or within absolute, is ignored"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["version", "id", "type", "a", "b"],
  "additionalProperties": false,
  "definitions": {
    "result": {
      "title": "diff_results (success response)",
      "type": "object",
      "properties": {
        "version": {
          "const": 1,
          "description": "Wire protocol version; checked on every message"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Echoes the id of the diff_results request"
        },
        "type": {
          "const": "result"
        },
        "empty": {
          "type": "boolean",
          "description": "No difference in any dimension"
        },
        "outcome": {
          "type": ["object", "null"],
          "properties": {
            "a": {
              "type": "string"
            },
            "b": {
              "type": "string"
            },
            "class": {
              "enum": ["breaking", "behavioural", "cost", "ignored"],
              "description": "breaking (outcome, return, storage, auth), behavioural (events), cost (a resource beyond tolerance) or ignored (#569)"
            }
          },
          "required": ["a", "b", "class"],
          "additionalProperties": false,
          "description": "Set when one side returned and the other failed, or they failed differently: ok, or '<kind> error <code>'. The values are compared only when both returned"
        },
        "return_value": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "JSON pointer to the first place the values differ; empty for the whole value"
                },
                "a": {
                  "description": "A's value there, tagged ({type, value}); null where A has nothing"
                },
                "b": {
                  "description": "B's value there; null where B has nothing"
                },
                "class": {
                  "enum": ["breaking", "behavioural", "cost", "ignored"],
                  "description": "breaking (outcome, return, storage, auth), behavioural (events), cost (a resource beyond tolerance) or ignored (#569)"
                }
              },
              "required": ["path", "a", "b", "class"],
              "additionalProperties": true
            }
          ],
          "description": "The first difference in the returned values"
        },
        "events": {
          "type": "object",
          "properties": {
            "added": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "class": {
                    "enum": ["breaking", "behavioural", "cost", "ignored"],
                    "description": "breaking (outcome, return, storage, auth), behavioural (events), cost (a resource beyond tolerance) or ignored (#569)"
                  }
                },
                "required": ["index", "class"],
                "additionalProperties": true
              }
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "class": {
                    "enum": ["breaking", "behavioural", "cost", "ignored"],
                    "description": "breaking (outcome, return, storage, auth), behavioural (events), cost (a resource beyond tolerance) or ignored (#569)"
                  }
                },
                "required": ["index", "class"],
                "additionalProperties": true
              }
            },
            "changed": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "class": {
                    "enum": ["breaking", "behavioural", "cost", "ignored"],
                    "description": "breaking (outcome, return, storage, auth), behavioural (events), cost (a resource beyond tolerance) or ignored (#569)"
                  }
                },
                "required": ["index", "class"],
                "additionalProperties": true
              }
            }
          },
          "required": ["added", "removed", "changed"],
          "additionalProperties": false,
          "description": "By index: same emitter and topics with another payload is changed (with path, a, b); otherwise A's event is removed and B's added"
        },
        "storage": {
          "type": "object",
          "properties": {
            "added": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "The LedgerKey in words"
                  },
                  "key_xdr": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9+/]+={0,2}$"
                  },
                  "class": {
                    "enum": ["breaking", "behavioural", "cost", "ignored"],
                    "description": "breaking (outcome, return, storage, auth), behavioural (events), cost (a resource beyond tolerance) or ignored (#569)"
                  }
                },
                "required": ["key", "key_xdr", "class"],
                "additionalProperties": true
              }
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "The LedgerKey in words"
                  },
                  "key_xdr": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9+/]+={0,2}$"
                  },
                  "class": {
                    "enum": ["breaking", "behavioural", "cost", "ignored"],
                    "description": "breaking (outcome, return, storage, auth), behavioural (events), cost (a resource beyond tolerance) or ignored (#569)"
                  }
                },
                "required": ["key", "key_xdr", "class"],
                "additionalProperties": true
              }
            },
            "changed": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "The LedgerKey in words"
                  },
                  "key_xdr": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9+/]+={0,2}$"
                  },
                  "class": {
                    "enum": ["breaking", "behavioural", "cost", "ignored"],
                    "description": "breaking (outcome, return, storage, auth), behavioural (events), cost (a resource beyond tolerance) or ignored (#569)"
                  }
                },
                "required": ["key", "key_xdr", "class"],
                "additionalProperties": true
              }
            },
            "ttl": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "The LedgerKey in words"
                  },
                  "key_xdr": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9+/]+={0,2}$"
                  },
                  "class": {
                    "enum": ["breaking", "behavioural", "cost", "ignored"],
                    "description": "breaking (outcome, return, storage, auth), behavioural (events), cost (a resource beyond tolerance) or ignored (#569)"
                  }
                },
                "required": ["key", "key_xdr", "class"],
                "additionalProperties": true
              }
            }
          },
          "required": ["added", "removed", "changed", "ttl"],
          "additionalProperties": false,
          "description": "By ledger key: written only by B (added), only by A (removed), to another value (changed, path into the contract-data value; an instance by its storage map, its executable left out), or with another TTL (ttl)"
        },
        "auth": {
          "type": "object",
          "properties": {
            "client_breaking": {
              "type": "boolean",
              "description": "Any auth difference: a payload signed for A no longer matches B"
            },
            "added": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "signer": {
                    "type": "string",
                    "minLength": 1,
                    "description": "An address (G\u2026/C\u2026), or 'source account'"
                  },
                  "class": {
                    "enum": ["breaking", "behavioural", "cost", "ignored"],
                    "description": "breaking (outcome, return, storage, auth), behavioural (events), cost (a resource beyond tolerance) or ignored (#569)"
                  }
                },
                "required": ["signer", "class"],
                "additionalProperties": true
              }
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "signer": {
                    "type": "string",
                    "minLength": 1,
                    "description": "An address (G\u2026/C\u2026), or 'source account'"
                  },
                  "class": {
                    "enum": ["breaking", "behavioural", "cost", "ignored"],
                    "description": "breaking (outcome, return, storage, auth), behavioural (events), cost (a resource beyond tolerance) or ignored (#569)"
                  }
                },
                "required": ["signer", "class"],
                "additionalProperties": true
              }
            },
            "changed": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "signer": {
                    "type": "string",
                    "minLength": 1,
                    "description": "An address (G\u2026/C\u2026), or 'source account'"
                  },
                  "class": {
                    "enum": ["breaking", "behavioural", "cost", "ignored"],
                    "description": "breaking (outcome, return, storage, auth), behavioural (events), cost (a resource beyond tolerance) or ignored (#569)"
                  }
                },
                "required": ["signer", "class"],
                "additionalProperties": true
              }
            }
          },
          "required": ["client_breaking", "added", "removed", "changed"],
          "additionalProperties": false
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": {
                "enum": [
                  "instructions",
                  "mem_bytes",
                  "read_bytes",
                  "write_bytes",
                  "read_entries",
                  "write_entries",
                  "resource_fee"
                ]
              },
              "a": {
                "type": "integer"
              },
              "b": {
                "type": "integer"
              },
              "delta": {
                "type": "integer"
              },
              "percent": {
                "type": ["number", "null"],
                "description": "delta as % of a, one decimal; null when a is 0"
              },
              "class": {
                "enum": ["breaking", "behavioural", "cost", "ignored"],
                "description": "breaking (outcome, return, storage, auth), behavioural (events), cost (a resource beyond tolerance) or ignored (#569)"
              }
            },
            "required": ["metric", "a", "b", "delta", "percent", "class"],
            "additionalProperties": false
          },
          "description": "Each metric both sides give that moved"
        },
        "summary": {
          "type": "object",
          "properties": {
            "breaking": {
              "type": "integer",
              "minimum": 0
            },
            "behavioural": {
              "type": "integer",
              "minimum": 0
            },
            "cost": {
              "type": "integer",
              "minimum": 0
            },
            "ignored": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["breaking", "behavioural", "cost", "ignored"],
          "additionalProperties": false,
          "description": "The differences counted by class; ignored ones are counted too"
        }
      },
      "required": [
        "version",
        "id",
        "type",
        "empty",
        "summary",
        "outcome",
        "return_value",
        "events",
        "storage",
        "auth",
        "resources"
      ],
      "additionalProperties": false
    }
  }
}
