{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://signet.dev/schemas/sandbox/v1/cli-call-result.json",
  "title": "signet sandbox call --json",
  "description": "The one object `signet sandbox call --json` writes to stdout (#555). Top-level keys are camelCase like the rest of the CLI's JSON; the nested simulator objects (error, events, modifiedEntries, resources, fee, cost) pass through in the protocol's own snake_case shapes from simulate.json and contract_error.json.",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "minLength": 56,
      "description": "The contract called (C...)"
    },
    "function": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "object",
      "description": "The named arguments, as JSON"
    },
    "sourceAccount": {
      "type": "string",
      "description": "--source-account, when given"
    },
    "network": {
      "type": "string",
      "minLength": 1
    },
    "forkId": {
      "type": "string",
      "minLength": 1,
      "description": "<contract>@<forkLedger>"
    },
    "forkLedger": {
      "type": "integer",
      "minimum": 1
    },
    "protocol": {
      "type": "integer",
      "minimum": 1
    },
    "session": {
      "type": "string",
      "description": "--session, when given"
    },
    "swappedWasm": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "The --wasm executable's hash, when one was swapped in"
    },
    "outcome": {
      "enum": ["result", "contract_error"]
    },
    "returnValue": {
      "description": "The return value decoded with the contract's spec"
    },
    "returnValueXdr": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "error": {
      "type": "object",
      "description": "The contract_error, for outcome contract_error: kind, code, message, decoded"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "auth": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9+/]+={0,2}$"
      }
    },
    "modifiedEntries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "resources": {
      "type": "object"
    },
    "fee": {
      "type": "object"
    },
    "cost": {
      "type": "object"
    },
    "misses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9+/]+={0,2}$"
      }
    },
    "drift": {
      "type": "object",
      "properties": {
        "forkLedger": {
          "type": "integer"
        },
        "newestLedger": {
          "type": "integer"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["forkLedger", "newestLedger", "keys"],
      "additionalProperties": false
    },
    "seed": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authEntries": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "The recorded auth in plain terms (simulate's auth_entries)"
    },
    "forkTime": {
      "type": "string",
      "description": "When the fork ledger closed (RFC 3339)"
    },
    "authMode": {
      "enum": ["record", "strict", "enforce"]
    },
    "ledger": {
      "type": "object",
      "description": "The ledger the call ran at; overridden when --ledger-seq, --timestamp or --advance moved it (#558)",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        },
        "protocol": {
          "type": "integer",
          "minimum": 1
        },
        "overridden": {
          "const": true,
          "description": "The call ran at a sequence or timestamp other than the session's (#558)"
        }
      },
      "required": ["sequence", "timestamp", "protocol"],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "description": "The limits the call ran under, when --unlimited or --budget-instructions overrode the network's",
      "properties": {
        "instructions": {
          "type": "integer",
          "minimum": 1
        },
        "mem_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["instructions", "mem_bytes"],
      "additionalProperties": false
    },
    "unlimited": {
      "const": true,
      "description": "--unlimited was given"
    },
    "archived": {
      "type": "array",
      "description": "Archived entries the call read (#558): a persistent one is restored by the call, as the network does from protocol 23; an expired temporary one reads as absent",
      "items": {
        "type": "object",
        "properties": {
          "key_xdr": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$",
            "description": "LedgerKey"
          },
          "key": {
            "type": "string",
            "description": "The key in plain terms"
          },
          "live_until_ledger": {
            "type": "integer",
            "minimum": 0,
            "description": "The ledger its TTL ran out after"
          },
          "outcome": {
            "enum": ["restored", "expired"]
          }
        },
        "required": ["key_xdr", "key", "live_until_ledger", "outcome"],
        "additionalProperties": false
      }
    },
    "contracts": {
      "type": "array",
      "description": "The other contracts the call reached, by reading their instance, in the order it reached them (#552)",
      "items": {
        "type": "object",
        "properties": {
          "contract_id": {
            "type": "string",
            "pattern": "^C[A-Z2-7]{55}$"
          },
          "executable": {
            "enum": ["wasm", "stellar_asset", "external_ref"]
          },
          "asset": {
            "type": "string",
            "minLength": 1,
            "description": "A Stellar Asset Contract's asset: native, or CODE:ISSUER"
          }
        },
        "required": ["contract_id"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract",
    "function",
    "args",
    "network",
    "forkId",
    "forkLedger",
    "protocol",
    "outcome",
    "events",
    "auth",
    "modifiedEntries",
    "misses",
    "drift",
    "seed",
    "authEntries",
    "forkTime",
    "authMode",
    "contracts"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "result"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "returnValueXdr": true
        },
        "required": ["returnValueXdr"]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "contract_error"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "error": true
        },
        "required": ["error"]
      }
    }
  ]
}
