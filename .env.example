# Database (optional for the web app — the /p profile pages work without it)
DATABASE_URL="postgresql://signet:signet@localhost:5432/signet"

# Stellar (server / indexer)
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=signet.dev
# Required in production (>=16 chars) — session HMAC signing key for SIWS auth.
# Generate with: openssl rand -base64 24
SIGNET_AUTH_SECRET=
# Optional. Unix epoch milliseconds — sessions issued at or before this time are
# rejected. Bump to revoke every existing session after a secret rotation.
SIGNET_SESSIONS_VALID_AFTER=

# Wallet + on-chain Identity Registry (client-side)
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Set once the identity-registry contract is deployed; until then the
# "Claim your handle" flow shows an honest "Phase 2" message instead of failing.
# Live testnet deployment (2026-07-09, admin key alias "signet"):
#   NEXT_PUBLIC_IDENTITY_REGISTRY_ID=CASFJHI5PQSRWS7JV25CF7FOMRKIVBP3RXRP3E2GH2CV4BCAG7FUJRCN
NEXT_PUBLIC_IDENTITY_REGISTRY_ID=

# Indexer attestation worker — reads claim/release events from the registry.
# Falls back to NEXT_PUBLIC_IDENTITY_REGISTRY_ID if unset. Leave empty and the
# worker no-ops (curated seed data stays the source of truth).
INDEXER_REGISTRY_CONTRACT_ID=
# How many ledgers back to start reading on first run (no cursor yet).
INDEXER_EVENT_WINDOW_LEDGERS=17280
# Indexer main loop period (milliseconds). Default 30000.
INDEXER_TICK_INTERVAL_MS=30000

# /handles directory — reads the registry's claim/release events directly,
# no database involved. Falls back to NEXT_PUBLIC_IDENTITY_REGISTRY_ID /
# NEXT_PUBLIC_SOROBAN_RPC_URL if unset.
REGISTRY_CONTRACT_ID=
SOROBAN_RPC_URL=
# How many ledgers back to scan on every request (public RPC only retains a
# bounded window anyway; this has no persisted cursor between requests).
REGISTRY_EVENT_WINDOW_LEDGERS=17280

# --- Deploying your own Identity Registry (infra/deploy-contract.sh) ---
# 1. Generate a clearly-named key (default account is "deployer", override with
#    STELLAR_ACCOUNT): `stellar keys generate deployer --network testnet --fund`
#    Use a distinct, clearly-named key per contract/admin — each key is its own
#    Stellar account (own address, own balance), so name it for what it's for.
# 2. If key generation or deploy fails with "rpc-url is used but network
#    passphrase is missing" (a `--network testnet` alias resolution bug seen on
#    stellar CLI 25.2.0), work around it:
#      - fund manually: curl "https://friendbot.stellar.org/?addr=<G...address>"
#      - pass explicit flags instead of --network testnet on deploy/invoke:
#        --rpc-url https://soroban-testnet.stellar.org \
#        --network-passphrase "Test SDF Network ; September 2015"
# 3. Run: STELLAR_ACCOUNT=<key-name> NETWORK=testnet ./infra/deploy-contract.sh
