 "functions": [
  {
   "name": "claim",
   "doc": "Bind `handle` to `wallet`. Requires the wallet's authorization, which\nis the cryptographic proof of ownership. Fails if the handle is already\ntaken or the wallet already owns a handle.",
   "isConstructor": false,
   "inputs": [
    {
     "name": "handle",
     "doc": "",
     "type": "string"
    },
    {
     "name": "wallet",
     "doc": "",
     "type": "address"
    }
   ],
   "outputs": [
    {
     "type": "result",
     "ok": "void",
     "error": "error"
    }
   ]
  },
  {
   "name": "count",
   "doc": "The binding counter: an O(1) UPPER BOUND on bound handles, not a live\ntotal. It is adjusted on `claim` and in `remove_binding`, but a binding\nwhose persistent entries archive unaccessed runs no contract code, so\nnothing ever subtracts it — the counter can only drift upward, and\nthere is no on-chain list to derive a true total from (enumerate via\nthe event stream). Callers must present it as \"recorded\", never as\n\"currently bound\"; only `resolve` proves a specific binding is live.",
   "isConstructor": false,
   "inputs": [],
   "outputs": [
    "u32"
   ]
  },
  {
   "name": "lookup",
   "doc": "Reverse lookup: the handle a wallet owns, if any.",
   "isConstructor": false,
   "inputs": [
    {
     "name": "wallet",
     "doc": "",
     "type": "address"
    }
   ],
   "outputs": [
    {
     "type": "option",
     "value": "string"
    }
   ]
  },
  {
   "name": "release",
   "doc": "Release a handle. Only the owning wallet may call this.",
   "isConstructor": false,
   "inputs": [
    {
     "name": "handle",
     "doc": "",
     "type": "string"
    }
   ],
   "outputs": [
    {
     "type": "result",
     "ok": "void",
     "error": "error"
    }
   ]
  },
  {
   "name": "resolve",
   "doc": "Resolve a handle to its owning wallet, if bound.",
   "isConstructor": false,
   "inputs": [
    {
     "name": "handle",
     "doc": "",
     "type": "string"
    }
   ],
   "outputs": [
    {
     "type": "option",
     "value": "address"
    }
   ]
  },
  {
   "name": "is_bound",
   "doc": "Whether a handle is currently bound.",
   "isConstructor": false,
   "inputs": [
    {
     "name": "handle",
     "doc": "",
     "type": "string"
    }
   ],
   "outputs": [
    "bool"
   ]
  },
  {
   "name": "set_admin",
   "doc": "Hand moderation authority to `new_admin`. Requires the current admin.\n\nWithout this the admin is write-once: a compromised or lost key would be\npermanent, and the only remedy would be redeploying the registry, which\nabandons every existing binding. Rotation is deliberately separate from\ncontract upgradeability — the wasm stays immutable.",
   "isConstructor": false,
   "inputs": [
    {
     "name": "new_admin",
     "doc": "",
     "type": "address"
    }
   ],
   "outputs": [
    {
     "type": "result",
     "ok": "void",
     "error": "error"
    }
   ]
  },
  {
   "name": "initialize",
   "doc": "One-time setup. Records the admin used for moderation actions.\n\n`admin.require_auth()` is what stops the deployment being hijacked.\nDeploying and initializing are two separate transactions, so without it\nanyone watching the ledger could land their own `initialize` in the gap,\nbecome admin, and hold `admin_revoke` — the power to force-unbind any\nhandle — permanently, since the registry can only be initialized once.",
   "isConstructor": false,
   "inputs": [
    {
     "name": "admin",
     "doc": "",
     "type": "address"
    }
   ],
   "outputs": [
    {
     "type": "result",
     "ok": "void",
     "error": "error"
    }
   ]
  },
  {
   "name": "admin_revoke",
   "doc": "Force-remove a binding. Admin-only moderation escape hatch.",
   "isConstructor": false,
   "inputs": [
    {
     "name": "handle",
     "doc": "",
     "type": "string"
    }
   ],
   "outputs": [
    {
     "type": "result",
     "ok": "void",
     "error": "error"
    }
   ]
  },
  {
   "name": "resolve_batch",
   "doc": "Resolve multiple handles to their owning wallets, positionally.\n\nReturns `None` for any handle that is not currently bound. Rejects\nbatches larger than [`MAX_BATCH_SIZE`].",
   "isConstructor": false,
   "inputs": [
    {
     "name": "handles",
     "doc": "",
     "type": {
      "type": "vec",
      "element": "string"
     }
    }
   ],
   "outputs": [
    {
     "type": "result",
     "ok": {
      "type": "vec",
      "element": {
       "type": "option",
       "value": "address"
      }
     },
     "error": "error"
    }
   ]
  },
  {
   "name": "transfer_handle",
   "doc": "Transfer a handle to a new wallet. Requires authentication from the current owner.\nFails if the handle is not found or if the target wallet already holds a handle.",
   "isConstructor": false,
   "inputs": [
    {
     "name": "handle",
     "doc": "",
     "type": "string"
    },
    {
     "name": "new_wallet",
     "doc": "",
     "type": "address"
    }
   ],
   "outputs": [
    {
     "type": "result",
     "ok": "void",
     "error": "error"
    }
   ]
  }
 ],
