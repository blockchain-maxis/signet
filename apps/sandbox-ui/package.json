{
  "name": "@signet/sandbox-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The signet dev local UI: a static app the CLI embeds and serves on 127.0.0.1 (#579).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config ../../eslint.config.js",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@signet/spec": "workspace:*",
    "@signet/visualiser": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "7.3.7"
  }
}
