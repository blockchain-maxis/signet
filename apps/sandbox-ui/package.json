{
  "name": "@signet/sandbox-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The signet dev local UI: a static app the CLI embeds and serves on 127.0.0.1 (#579).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config ../../eslint.config.js",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" && vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@signet/spec": "workspace:*",
    "@signet/visualiser": "workspace:*",
    "@stellar/stellar-sdk": "^16.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "^10.6.1",
    "jsdom": "30.1.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
