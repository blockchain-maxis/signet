// BuildClaimOp builds the InvokeHostFunction operation that calls `claim`.
//
// Bind `handle` to `wallet`. Requires the wallet's authorization, which
// is the cryptographic proof of ownership. Fails if the handle is already
// taken or the wallet already owns a handle.
func BuildClaimOp(handle string, wallet string) (txnbuild.InvokeHostFunction, error) {
	args := make([]xdr.ScVal, 0, 2)
	{
		v, err := scString(handle)
		if err != nil {
			return txnbuild.InvokeHostFunction{}, fmt.Errorf("handle: %w", err)
		}
		args = append(args, v)
	}
	{
		v, err := scAddress(wallet)
		if err != nil {
			return txnbuild.InvokeHostFunction{}, fmt.Errorf("wallet: %w", err)
		}
		args = append(args, v)
	}
	return invoke("claim", args)
}

